# Required
PUBLIC_BASE_URL=http://localhost:3000        # the URL people (and Instagram) use to reach the app
ANTHROPIC_API_KEY=                           # from console.anthropic.com
DATA_DIR=./data                              # SQLite database + uploaded images; use a persistent volume in production
PORT=3000
BACKGROUND_JOBS=on                           # daily compliance-page check + weekly suggestions digest; "off" on extra instances

# AI model per agent (README "AI models"). An unsupported name stops the app at startup.
MODEL_WRITER=claude-sonnet-5
MODEL_ARTICLE_WRITER=claude-sonnet-5
MODEL_CAROUSEL_WRITER=claude-sonnet-5
MODEL_TREND_SCOUT=claude-sonnet-5
MODEL_COMPLIANCE=claude-opus-5
MODEL_IMAGE_CHECK=claude-sonnet-5
MODEL_COACH=claude-opus-5

# Instagram carousels (README "Instagram carousels"). Without GEMINI_API_KEY, carousels get colour backgrounds.
GEMINI_API_KEY=                              # from Google AI Studio; used only for carousel pictures
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image    # or gemini-3.1-flash-lite-image, gemini-3-pro-image
GLASS_SLIDES_URL=                            # e.g. https://glass-slides.singh-akash0717.workers.dev

# Trial mode: these channels record a simulated publish instead of posting. Remove a channel once its keys are set.
DRY_RUN_CHANNELS=website,instagram,linkedin,x

# Website: signed webhook to your site (see README "Website webhook")
WEBSITE_WEBHOOK_URL=
WEBSITE_WEBHOOK_SECRET=                      # long random string shared with your web developer

# Instagram (professional account)
IG_API_BASE=                                 # e.g. https://graph.instagram.com/v24.0 or https://graph.facebook.com/v24.0
IG_USER_ID=
IG_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=                         # urn:li:organization:<id> (company page) or urn:li:person:<id>
LINKEDIN_VERSION=                            # YYYYMM, e.g. 202609

# X (OAuth 1.0a keys from the developer portal, app permission "Read and write")
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
